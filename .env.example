# This computer uses a local file. The internet copy uses Postgres.
# On the host, set DATABASE_URL to the direct Postgres address, and set
# DATABASE_URL_UNPOOLED to that same direct address.
DATABASE_URL="file:./dev.db"

# Random string, at least 48 characters. Never commit the real value.
SESSION_SECRET="replace-with-a-random-48-character-string"

# Show SMS codes on the login screen and label them Demo mode.
# The server refuses to start when this is true and NODE_ENV=production,
# unless ALLOW_DEMO_IN_PROD=true.
DEMO_MODE="true"
DEMO_OTP_VISIBLE="true"
ALLOW_DEMO_IN_PROD="false"

# Optional until a later step. Leave empty on this computer.
PIN_PEPPER=
CRON_SECRET=
# The owner's own account. Leave blank in a shared copy. Never commit the real values.
OWNER_NAME=
OWNER_PHONE=

# Optional text when a number locks. Leave empty until Africa's Talking is connected.
# The text goes to OWNER_PHONE. The number is never written in the program.
AT_USERNAME=
AT_API_KEY=
AT_FROM=

# Optional error reporting. Leave empty to keep the monitor silent.
SENTRY_DSN=

# Later phases. Names are configurable; leave the key empty until a provider is connected.
ENABLE_AI_IMPORT="false"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_REASONING=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
